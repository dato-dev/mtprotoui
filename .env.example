# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Any long random string
JWT_SECRET=CHANGE_ME_JWT_SECRET

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Аварийный сброс пароля админа из ADMIN_PASSWORD при старте.
# Включить (true), перезапустить api, войти, сменить пароль — затем вернуть false.
ADMIN_PASSWORD_RESET=false

# Домен для WebUI (Let's Encrypt включается автоматически для реального домена)
# Локально: DOMAIN=localhost (только HTTP, без сертификата)
DOMAIN=mtproto.example.com

# Email для Let's Encrypt (рекомендуется при использовании реального домена)
ACME_EMAIL=admin@example.com

# Порты Caddy на хосте (80/443 нужны для LE)
HTTP_PORT=80
HTTPS_PORT=443

# Интервал фоновых проверок серверов (ping + TCP)
HEALTH_INTERVAL=5m

# Интервал авто-ротации SNI для серверов с включённой опцией (0 = выключено).
# Пример: 24h. Внимание: ротация меняет secret и ссылку tg://proxy.
SNI_ROTATION_INTERVAL=0

# ICMP ping: true/false (для ping нужен cap_add: NET_RAW в compose)
PING_ENABLED=true

# Количество ping-пакетов за одну проверку
PING_COUNT=3

# Таймаут одной ping-проверки (например 4s, 10s)
PING_TIMEOUT=4s

# Таймаут TCP-проверки порта MTProto
TCP_TIMEOUT=4s
